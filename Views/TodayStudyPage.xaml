<Page
    x:Class="NihongoVocab.Views.TodayStudyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:NihongoVocab.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,20,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部操作与筛选控制条 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：标题、状态下拉筛选与指标徽章 -->
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE823;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="PageTitleTextBlock" Text="今日学习" Style="{ThemeResource TitleTextBlockStyle}" FontSize="20"/>

                <Border Width="1" Height="18" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,0"/>

                <!-- 状态筛选下拉菜单（记得、遗忘） -->
                <TextBlock x:Name="StatusFilterLabelTextBlock" Text="状态筛选:" VerticalAlignment="Center" FontSize="13" Opacity="0.8"/>
                <ComboBox x:Name="StatusFilterComboBox" SelectedIndex="0" Width="140"
                          SelectionChanged="StatusFilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="全部打卡" Tag="All"/>
                    <ComboBoxItem Content="记得 (Good)" Tag="Remember"/>
                    <ComboBoxItem Content="遗忘 (Again)" Tag="Forget"/>
                </ComboBox>

                <!-- 今日统计胶囊 -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="TotalTodayLabelTextBlock" Text="今日学习:" FontSize="12" Opacity="0.7"/>
                            <TextBlock Text="{x:Bind ViewModel.TotalTodayCount, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1A22C55E" CornerRadius="4" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="RememberLabelTextBlock" Text="记得:" FontSize="12" Foreground="#22C55E"/>
                            <TextBlock Text="{x:Bind ViewModel.RememberCount, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#22C55E"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1AEF4444" CornerRadius="4" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="ForgetLabelTextBlock" Text="遗忘:" FontSize="12" Foreground="#EF4444"/>
                            <TextBlock Text="{x:Bind ViewModel.ForgetCount, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#EF4444"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- 右侧：视图模式切换（列表 vs 网格）与刷新 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- 视图切换单选按钮组 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="2">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="GridViewButton" Click="GridViewButton_Click" Style="{ThemeResource SubtleButtonStyle}" Padding="8,5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xF0E2;" FontSize="12"/>
                                <TextBlock x:Name="GridViewButtonText" Text="网格" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ListViewButton" Click="ListViewButton_Click" Style="{ThemeResource SubtleButtonStyle}" Padding="8,5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8D2;" FontSize="12"/>
                                <TextBlock x:Name="ListViewButtonText" Text="列表" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Button Click="RefreshButton_Click" Style="{ThemeResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                        <TextBlock x:Name="RefreshButtonText" Text="刷新"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 主内容区：网格视图与列表视图双模式 -->
        <Grid Grid.Row="1">

            <!-- 1. 网格显示视图（动态卡片网格，绿色代表今日记得，红色代表今日遗忘；左键点击卡片原地切换） -->
            <ScrollViewer x:Name="GridScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.DisplayItems}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="160" MinItemHeight="96"
                                           MinRowSpacing="14" MinColumnSpacing="14"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TodayWordCardItem">
                            <Border CornerRadius="8" Padding="14,10"
                                    Background="{x:Bind CardBackground, Mode=OneWay}"
                                    BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}"
                                    BorderThickness="1.5"
                                    PointerPressed="Card_PointerPressed"
                                    DataContext="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind ClickToggleRatingTip, Mode=OneWay}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 纯单词文本 -->
                                    <TextBlock Text="{x:Bind WordText}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{x:Bind CardForeground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- 底部状态胶囊与打卡时间 -->
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border CornerRadius="4" Padding="6,2"
                                                Background="#33000000">
                                            <TextBlock Text="{x:Bind RatingText, Mode=OneWay}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{x:Bind CardForeground}"/>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{x:Bind ReviewTimeText}"
                                                   FontSize="10" Opacity="0.8" Foreground="{x:Bind CardForeground}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- 2. 列表显示视图（条目列表，右侧带状态切换按钮和撤销） -->
            <ListView x:Name="RecordsListView" ItemsSource="{x:Bind ViewModel.DisplayItems}"
                      SelectionMode="None" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:TodayWordCardItem">
                        <Border Margin="0,3" Padding="16,12" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                PointerPressed="Card_PointerPressed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind WordText}" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="{x:Bind ReviewTimeText}" FontSize="11" Opacity="0.5"/>
                                </StackPanel>

                                <!-- 状态切换按钮（显示今日标记的单词状态，点击对状态进行切换更改） -->
                                <Button Grid.Column="1" Click="ListItemToggleRating_Click" Tag="{x:Bind}"
                                        Margin="16,0" Padding="14,6" CornerRadius="6"
                                        Background="{x:Bind StatusPillBackground, Mode=OneWay}"
                                        BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}" BorderThickness="1"
                                        ToolTipService.ToolTip="{x:Bind ClickToggleOppositeTip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="{x:Bind StatusPillForeground, Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind RatingText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{x:Bind StatusPillForeground, Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>

                                <!-- 撤销本次记录按钮 -->
                                <Button Grid.Column="2" Click="ListItemRevert_Click" Tag="{x:Bind}"
                                        Style="{ThemeResource SubtleButtonStyle}" Padding="8"
                                        ToolTipService.ToolTip="{x:Bind RevertTodayRecordTip, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </Grid>
    </Grid>
</Page>
