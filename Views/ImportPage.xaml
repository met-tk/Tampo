<Page
    x:Class="NihongoVocab.Views.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NihongoVocab.Models"
    mc:Ignorable="d">

    <Grid x:Name="PageRootGrid" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部控制条（极简设计） -->
        <Grid x:Name="TopControlGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <StackPanel x:Name="TopTitlePanel" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="PageTitleTextBlock" Text="导入词汇" Style="{ThemeResource TitleTextBlockStyle}" FontSize="20"/>
                    <Border Width="1" Height="18" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="8,0"/>
                </StackPanel>

                <!-- 预设选择器 -->
                <StackPanel x:Name="PresetControlPanel" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock x:Name="PresetLabelTextBlock" Text="文本清洗预设:" VerticalAlignment="Center" Opacity="0.8"/>
                    <ComboBox x:Name="PresetComboBox" Width="200"
                              ItemsSource="{x:Bind ViewModel.Presets}"
                              SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:CleansingPreset">
                                <TextBlock Text="{x:Bind Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- 管理预设按钮（单色矢量图标） -->
                    <Button Click="ManagePresetsButton_Click" Style="{ThemeResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                            <TextBlock x:Name="ManagePresetsButtonText" Text="管理清洗预设"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- 操作按钮组：置顶按钮(纯图标) + 沉浸式模式按钮(纯图标) + 批量导入按钮 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- 窗口置顶按钮 (纯单色图标，严格无文字标签) -->
                <Button x:Name="PinTopButton" Click="PinTopButton_Click" Style="{ThemeResource SubtleButtonStyle}"
                        Visibility="Collapsed" Padding="8,8">
                    <FontIcon x:Name="PinTopIcon" Glyph="&#xE840;" FontSize="14"/>
                </Button>

                <!-- 沉浸式模式切换按钮 (纯单色图标，严格无文字标签) -->
                <Button x:Name="ImmersiveButton" Click="ImmersiveButton_Click" Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8,8">
                    <FontIcon x:Name="ImmersiveIcon" Glyph="&#xE740;" FontSize="14"/>
                </Button>

                <!-- 批量导入保存按钮 -->
                <Button x:Name="ImportActionButton" Click="ImportButton_Click"
                        Style="{ThemeResource AccentButtonStyle}" Padding="16,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE898;" FontSize="14"/>
                        <TextBlock x:Name="ImportButtonText" Text="导入至词库"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 左右极简双栏布局 (沉浸紧凑模式下动态切换为上下流式) -->
        <Grid x:Name="MainContentGrid" Grid.Row="1" ColumnSpacing="16" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="Col0" Width="1*"/>
                <ColumnDefinition x:Name="Col1" Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="Row0" Height="*"/>
                <RowDefinition x:Name="Row1" Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 左侧：原始文本输入区 -->
            <Grid x:Name="RawTextContainer" Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="RawTextPromptTextBlock" Text="在此粘贴或输入需要提取的日语原文（支持批量长文输入）：" FontSize="12" Opacity="0.7" Margin="0,0,0,6"/>
                <TextBox x:Name="RawTextBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                         PlaceholderText="输入或粘贴文本..."
                         Text="{x:Bind ViewModel.RawText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas, 'Cascadia Code', 'Yu Gothic UI', sans-serif"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <!-- 右侧：清洗候选词流式平铺预览 -->
            <Grid x:Name="CandidatesContainer" Grid.Row="0" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CandidatesPromptTextBlock" Text="清洗并提取出的候选词（鼠标悬浮高亮在原文中的位置，点击可移除单个）：" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <TextBlock x:Name="ExtractedCountLabelTextBlock" Text="提取总数:" FontSize="12" Opacity="0.7"/>
                        <TextBlock Text="{x:Bind ViewModel.ExtractedCount, Mode=OneWay, Converter={StaticResource WordCountSuffixConverter}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.CleanedWords}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="130" MinItemHeight="42" MinRowSpacing="8" MinColumnSpacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,6"
                                            Tag="{x:Bind}"
                                            PointerEntered="CandidateChip_PointerEntered"
                                            PointerExited="CandidateChip_PointerExited">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind}" FontSize="13" FontWeight="Medium"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Style="{ThemeResource SubtleButtonStyle}"
                                                    Padding="4" Margin="4,0,0,0"
                                                    Tag="{x:Bind}"
                                                    Click="DeleteCandidate_Click">
                                                <FontIcon Glyph="&#xE711;" FontSize="10" Opacity="0.7"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
