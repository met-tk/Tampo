<ContentDialog
    x:Class="NihongoVocab.Views.Dialogs.ManagePresetsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:NihongoVocab.Converters"
    xmlns:models="using:NihongoVocab.Models"
    mc:Ignorable="d"
    Title="正则清洗预设管理"
    PrimaryButtonText="完成"
    CloseButtonText="关闭"
    DefaultButton="Primary"
    CornerRadius="8">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
            <x:Double x:Key="ContentDialogMinWidth">780</x:Double>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        </ResourceDictionary>
    </ContentDialog.Resources>

    <Grid Margin="0,8,0,0" Width="820" Height="460" ColumnSpacing="16" HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <!-- 左侧：已有预设列表 -->
            <ColumnDefinition Width="340"/>
            <!-- 右侧：配置新预设与即时验证 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左列：已保存的预设列表 -->
        <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="SavedRulesTitleText" Text="已保存规则库" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                    <TextBlock x:Name="SavedRulesTipText" Text="点击选择可带入右侧表单进行测试或编辑" FontSize="11" Opacity="0.6"/>
                </StackPanel>

                <ListView x:Name="PresetsListView" Grid.Row="1" SelectionMode="Single"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionChanged="PresetsListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:CleansingPreset">
                            <Grid Padding="6,6" Margin="0,2" CornerRadius="6"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{x:Bind Pattern}" FontSize="11" Opacity="0.6" FontFamily="Consolas, 'Cascadia Code', monospace" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- 标记徽标 / 删除按钮 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4" Padding="4,2"
                                            Visibility="{x:Bind IsInverseFilter, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="反向" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                    </Border>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4" Padding="4,2"
                                            Visibility="{x:Bind MatchWholeLine, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="整行" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    </Border>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4" Padding="4,2"
                                            Visibility="{x:Bind IsBuiltIn, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="内置" FontSize="10" Opacity="0.7"/>
                                    </Border>
                                </StackPanel>

                                <Button Grid.Column="2" VerticalAlignment="Center"
                                        Visibility="{x:Bind IsBuiltIn, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}"
                                        Style="{ThemeResource SubtleButtonStyle}" Padding="4"
                                        ToolTipService.ToolTip="删除此自定义预设">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                    <Button.Flyout>
                                        <Flyout Placement="Left">
                                            <StackPanel Spacing="8" MinWidth="160" Padding="4">
                                                <TextBlock Text="确定删除此预设？" FontSize="12" FontWeight="Medium"/>
                                                <Button Content="删除" Style="{ThemeResource AccentButtonStyle}"
                                                        Tag="{x:Bind}" Click="ConfirmDeletePreset_Click"
                                                        HorizontalAlignment="Right" FontSize="11" Padding="10,4"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- 右列：规则配置与即时测试 -->
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 规则配置表单 -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="ConfigRulesTitleText" Text="自定义清洗规则配置" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PresetNameInput" PlaceholderText="输入预设名称..." Header="预设名称" FontSize="12"/>
                        <NumberBox x:Name="CaptureGroupInput" Grid.Column="1" Header="捕获组索引" Value="1" Minimum="0" Maximum="9" SpinButtonPlacementMode="Compact" FontSize="12"/>
                    </Grid>

                    <TextBox x:Name="PresetPatternInput" PlaceholderText="正则表达式（如：([ぁ-ん]+)）..." Header="正则表达式"
                             FontFamily="Consolas, 'Cascadia Code', monospace" FontSize="12"
                             TextChanged="PresetPatternInput_TextChanged"/>

                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <CheckBox x:Name="IsInverseFilterCheckBox" Content="反向过滤" FontSize="12"
                                      Click="IsInverseFilterCheckBox_Click" VerticalAlignment="Center"/>
                            <CheckBox x:Name="MatchWholeLineCheckBox" Content="匹配整行" FontSize="12"
                                      Click="MatchWholeLineCheckBox_Click" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button x:Name="AddPresetButton" Grid.Column="1" Click="AddPresetButton_Click"
                                Style="{ThemeResource AccentButtonStyle}" Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                <TextBlock x:Name="AddPresetButtonText" Text="保存为新预设" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 即时单行验证测试卡片 -->
            <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="InstantVerifyTitleText" Text="单行即时提取验证" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>

                    <TextBox Grid.Row="1" x:Name="TestLineInput" PlaceholderText="输入单行测试文本..."
                             Text="▪ 本日は晴天なり (ほんじつ)" TextChanged="TestLineInput_TextChanged" FontSize="12"/>

                    <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ValidationResultTextBlock" Text="提取结果：本日は晴天なり"
                                       FontFamily="Consolas, 'Cascadia Code', monospace" FontSize="12"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>
