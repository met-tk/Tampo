<Page
    x:Class="NihongoVocab.Views.AllWordsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NihongoVocab.Models"
    mc:Ignorable="d">

    <Grid Padding="24,20,24,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题与总体状态统计 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8F1;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontSize="20"/>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                           FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>

        </Grid>

        <!-- 主内容区：左侧时间树 + 分割条 + 右侧总览表格与批量状态操作 -->
        <Grid Grid.Row="1" x:Name="LayoutRootGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="320" MinWidth="260" MaxWidth="600"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：时间层级折叠树与上下分割条 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TreeRow" Height="1.2*" MinHeight="160"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition x:Name="BottomRow" Height="1*" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- 上半部分：时间维度折叠树 -->
                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xED28;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.TimeSliceTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TimeSliceTip, Mode=OneWay}" FontSize="11" Opacity="0.6"/>
                        </StackPanel>

                        <!-- 维度与展开折叠按钮 -->
                        <Grid Grid.Row="1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="DimensionComboBox" HorizontalAlignment="Stretch"
                                      SelectedIndex="2">
                                <ComboBoxItem Content="年 (年度汇总)" Tag="Year"/>
                                <ComboBoxItem Content="季度 (按季统计)" Tag="Quarter"/>
                                <ComboBoxItem Content="月 (按月归档)" Tag="Month"/>
                                <ComboBoxItem Content="周 (按周组织)" Tag="Week"/>
                                <ComboBoxItem Content="日 (精确每日)" Tag="Day"/>
                            </ComboBox>

                            <Button x:Name="ExpandAllButton" Grid.Column="1" Style="{ThemeResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="展开全部">
                                <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                            </Button>
                            <Button x:Name="CollapseAllButton" Grid.Column="2" Style="{ThemeResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="折叠全部">
                                <FontIcon Glyph="&#xE70E;" FontSize="12"/>
                            </Button>
                        </Grid>

                        <!-- 单层扁平模式复选框 -->
                        <CheckBox x:Name="FlatLevelModeCheckBox" Grid.Row="2" Content="{x:Bind ViewModel.FlatLevelModeText, Mode=OneWay}" FontSize="11" Margin="0,0,0,2"
                                  IsChecked="{x:Bind ViewModel.IsFlatLevelMode, Mode=TwoWay}"/>

                        <!-- 时间层级树（通过官方 TreeViewNode 原生层级引擎驱动，保证 100% 正确展示与展开） -->
                        <TreeView x:Name="HierarchyTreeView" Grid.Row="3"
                                  SelectionMode="Single">
                            <TreeView.ItemTemplate>
                                <DataTemplate x:DataType="TreeViewNode">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Padding="0,3">
                                        <FontIcon Glyph="&#xE82D;" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ((models:DateHierarchyNode)Content).Title}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <!-- 水平滑动分割条 RowSplitter -->
                <Border x:Name="RowSplitter" Grid.Row="1" Background="Transparent">
                    <Rectangle Height="2" VerticalAlignment="Center"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                </Border>

                <!-- 下半部分：时间切片筛选状态 与 自定义专属词单 整合卡片 -->
                <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 顶部模式切换选项卡（分段胶囊按钮组） -->
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="TabTimeSliceRadio" Grid.Column="0"
                                         HorizontalAlignment="Stretch"
                                         IsChecked="True"
                                         Style="{ThemeResource DefaultRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xED28;" FontSize="12"/>
                                    <TextBlock Text="{x:Bind ViewModel.TabTimeSliceText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="TabCustomListsRadio" Grid.Column="1"
                                         HorizontalAlignment="Stretch"
                                         Style="{ThemeResource DefaultRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8EC;" FontSize="12"/>
                                    <TextBlock Text="{x:Bind ViewModel.TabCustomListsText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="4,1" Margin="2,0,0,0">
                                        <TextBlock Text="{x:Bind ViewModel.WordLists.Count, Mode=OneWay}" FontSize="10" Opacity="0.7"/>
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                        </Grid>

                        <!-- 内容区 1：时间切片状态视图 -->
                        <Grid x:Name="TimeSliceViewGrid" Grid.Row="1" RowSpacing="8" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 切片标题与状态标签 -->
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE82D;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.TimeSliceSelectedLabel, Mode=OneWay}" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="4" Padding="6,4">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedNodeTitle, Mode=OneWay}" 
                                               FontSize="12" FontWeight="Medium" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                            <!-- 切片内状态分布徽章网格 -->
                            <Grid Grid.Row="1" ColumnSpacing="4" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="4,3">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SliceNewText, Mode=OneWay}" FontSize="10" Opacity="0.6" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.SliceNewCount, Mode=OneWay}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="4,3">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SliceLearningText, Mode=OneWay}" FontSize="10" Opacity="0.6" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.SliceLearningCount, Mode=OneWay}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="4,3">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SliceReviewingText, Mode=OneWay}" FontSize="10" Opacity="0.6" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.SliceReviewingCount, Mode=OneWay}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="4,3">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SliceMasteredText, Mode=OneWay}" FontSize="10" Opacity="0.6" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.SliceMasteredCount, Mode=OneWay}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 切片操作按钮组 -->
                            <StackPanel Grid.Row="3" Spacing="6">
                                <Button x:Name="PackSliceToListButton"
                                        IsEnabled="{x:Bind ViewModel.IsTimeSliceActive, Mode=OneWay}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                        <TextBlock Text="{x:Bind ViewModel.ButtonPackSliceToListText, Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="ViewAllTimeButton" Style="{ThemeResource SubtleButtonStyle}"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="12"/>
                                        <TextBlock Text="{x:Bind ViewModel.ButtonClearSliceText, Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 内容区 2：自定义专属词单视图（具备与归档模块完全相同的操作与交互） -->
                        <Grid x:Name="CustomListsViewGrid" Grid.Row="1" RowSpacing="6" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 词单顶部提示与清空筛选 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.CustomListsTitle, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind ViewModel.WordLists.Count, Mode=OneWay}" FontSize="10" Opacity="0.5"/>
                                </StackPanel>
                                <Button x:Name="ClearWordListFilterButton" Grid.Column="1" Style="{ThemeResource SubtleButtonStyle}"
                                        Padding="6,2" ToolTipService.ToolTip="取消词单筛选，查看全量单词">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <FontIcon Glyph="&#xE894;" FontSize="10"/>
                                        <TextBlock Text="清除筛选" FontSize="10"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 词单列表（独立滚动边界） -->
                            <ListView x:Name="CustomWordListsListView" Grid.Row="1"
                                      ItemsSource="{x:Bind ViewModel.WordLists}"
                                      SelectionMode="Single"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      SelectedItem="{x:Bind ViewModel.SelectedWordList, Mode=TwoWay}">
                                <ListView.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="MenuListRename" Text="重命名词单">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8AC;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="MenuListMerge" Text="合并至其他词单...">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE7EE;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="MenuListExport" Text="在浏览器中查看">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE774;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem x:Name="MenuListDissolve" Text="解散词单（词汇恢复未归档）">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </ListView.ContextFlyout>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:WordList">
                                        <Grid Padding="8,6" Margin="0,2" CornerRadius="6"
                                              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{x:Bind CreatedAt, Converter={StaticResource DateToStringConverter}}"
                                                           FontSize="10" Opacity="0.5"/>
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                    CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind WordCount}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 底部右键菜单提示 -->
                            <TextBlock Grid.Row="2" Text="右键词单可重命名、合并或解散" FontSize="10" Opacity="0.5" HorizontalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 中间：垂直列分割条 Splitter -->
            <Border x:Name="ColumnSplitter" Grid.Column="1"
                    Background="Transparent">
                <Rectangle Width="2" HorizontalAlignment="Center"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            </Border>

            <!-- 右侧：词库全量视图、状态切片与批量更新操作 -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18">
                <Grid RowSpacing="12" x:Name="RightDetailGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部统计徽章与状态筛选及搜索栏（自适应响应式布局） -->
                    <Grid x:Name="FilterBarGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="SearchRow" Height="0"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FilterCol" Width="*"/>
                            <ColumnDefinition x:Name="SearchCol" Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 状态切换单选按钮组（带横向弹性保护，永不截断） -->
                        <ScrollViewer x:Name="StateFilterScrollViewer"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled">
                            <StackPanel x:Name="StateFilterPanel" Orientation="Horizontal" Spacing="8">
                                <RadioButton x:Name="StateFilterAll" Content="{x:Bind ViewModel.FilterAllText, Mode=OneWay}" Tag="All" IsChecked="True"/>
                                <RadioButton x:Name="StateFilterNew" Content="{x:Bind ViewModel.FilterNewText, Mode=OneWay}" Tag="New"/>
                                <RadioButton x:Name="StateFilterLearning" Content="{x:Bind ViewModel.FilterLearningText, Mode=OneWay}" Tag="Learning"/>
                                <RadioButton x:Name="StateFilterReviewing" Content="{x:Bind ViewModel.FilterReviewText, Mode=OneWay}" Tag="Review"/>
                                <RadioButton x:Name="StateFilterMastered" Content="{x:Bind ViewModel.FilterMasteredText, Mode=OneWay}" Tag="Mastered"/>
                                <Border Width="1" Height="14" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" Margin="2,0"/>
                                <RadioButton x:Name="StateFilterUnarchived" Content="{x:Bind ViewModel.FilterUnarchivedText, Mode=OneWay}" Tag="Unarchived"/>
                                <RadioButton x:Name="StateFilterArchived" Content="{x:Bind ViewModel.FilterArchivedText, Mode=OneWay}" Tag="Archived"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 搜索框（支持自适应折行） -->
                        <AutoSuggestBox x:Name="WordSearchBox" Grid.Column="1"
                                        PlaceholderText="{x:Bind ViewModel.SearchWordsPlaceholder, Mode=OneWay}"
                                        QueryIcon="Find" Width="220"
                                        Margin="12,0,0,0"
                                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"/>
                    </Grid>

                    <!-- 批量选择提示工具栏 -->
                    <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="6" Padding="10,6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <CheckBox x:Name="SelectAllCheckBox" Content="{x:Bind ViewModel.SelectAllResultsText, Mode=OneWay}"/>
                                <TextBlock x:Name="SelectedCountTextBlock" Text="已选 0 项" 
                                           FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                                <Button x:Name="BatchCreateNewListButton" Style="{ThemeResource SubtleButtonStyle}"
                                        Padding="6,4" ToolTipService.ToolTip="将当前选中的所有单词打包为新的自定义词单">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE710;" FontSize="11"/>
                                        <TextBlock Text="{x:Bind ViewModel.ButtonCreateCustomListText, Mode=OneWay}" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="多选单词后，在已选中的单词上点击鼠标右键即可弹出批量操作菜单">
                                <FontIcon Glyph="&#xE8B0;" FontSize="12" Opacity="0.6"/>
                                <TextBlock x:Name="ContextMenuHintTextBlock" Text="{x:Bind ViewModel.RightClickActionHint, Mode=OneWay}" 
                                           FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 单词明细数据列表（带滑动多选与右键上下文菜单） -->
                    <ListView x:Name="WordsListView" Grid.Row="2"
                              ItemsSource="{x:Bind ViewModel.DisplayWords}"
                              SelectionMode="Multiple"
                              PointerReleased="WordsListView_PointerReleased"
                              PointerCaptureLost="WordsListView_PointerReleased">
                        <ListView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="MenuBatchCreateNewList" Text="新建自选词单...">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE710;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Name="MenuCopyLines" Text="一键复制 (换行)" Click="MenuCopyLines_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuFormatExport" Text="格式化导出..." Click="MenuFormatExport_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEDE1;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Name="MenuSetStateNew" Text="标记为：未学习">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8D2;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuSetStateMastered" Text="标记为：已掌握">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE73E;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Name="MenuReimportToday" Text="重新在今天导入">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xED28;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Name="MenuDeleteWords" Text="删除所选单词">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" Foreground="#EF4444"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Word">
                                <Grid Padding="12,8" Margin="0,2" CornerRadius="6"
                                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                                      PointerPressed="WordItem_PointerPressed"
                                      PointerEntered="WordItem_PointerEntered"
                                      PointerReleased="WordItem_PointerReleased">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 单词 -->
                                    <TextBlock Text="{x:Bind Text}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>

                                    <!-- 状态 -->
                                    <Border Grid.Column="1" CornerRadius="4" Padding="6,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind LearningStateText, Mode=OneWay}" FontSize="11" FontWeight="Medium"/>
                                    </Border>

                                    <!-- 复习指标与入库日期 -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ReviewCountText, Mode=OneWay}"
                                                   FontSize="11" Opacity="0.7"/>
                                        <TextBlock Text="{x:Bind CreatedAt, Converter={StaticResource DateToStringConverter}}"
                                                   FontSize="10" Opacity="0.45"/>
                                    </StackPanel>

                                    <!-- 下次复习间隔时间 -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind NextReviewIntervalText}" 
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Opacity="0.85" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{x:Bind NextReviewLabel, Mode=OneWay}" FontSize="10" Opacity="0.5" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
