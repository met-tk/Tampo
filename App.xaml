<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NihongoVocab.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NihongoVocab.Converters"
    xmlns:local="using:NihongoVocab">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- 覆盖 WinUI 3 弹窗默认白色半透明遮罩，必须作为 MergedDictionary 置于 XamlControlsResources 之后以生效 -->
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#B3000000" />
                            <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#B3000000" />
                            <Color x:Key="SmokeFillColorDefault">#B3000000</Color>
                            <SolidColorBrush x:Key="SystemControlPageBackgroundBaseMediumBrush" Color="#B3000000" />
                            <SolidColorBrush x:Key="ContentDialogDimmingThemeBrush" Color="#B3000000" />
                            <SolidColorBrush x:Key="SystemControlPageBackgroundMediumAltMediumBrush" Color="#B3000000" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#B3000000" />
                            <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#B3000000" />
                            <Color x:Key="SmokeFillColorDefault">#B3000000</Color>
                            <SolidColorBrush x:Key="SystemControlPageBackgroundBaseMediumBrush" Color="#B3000000" />
                            <SolidColorBrush x:Key="ContentDialogDimmingThemeBrush" Color="#B3000000" />
                            <SolidColorBrush x:Key="SystemControlPageBackgroundMediumAltMediumBrush" Color="#B3000000" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#59000000" />
                            <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#59000000" />
                            <Color x:Key="SmokeFillColorDefault">#59000000</Color>
                            <SolidColorBrush x:Key="SystemControlPageBackgroundBaseMediumBrush" Color="#59000000" />
                            <SolidColorBrush x:Key="ContentDialogDimmingThemeBrush" Color="#59000000" />
                            <SolidColorBrush x:Key="SystemControlPageBackgroundMediumAltMediumBrush" Color="#59000000" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <!-- 解除 WinUI 3 官方默认 548px 限制，支持现代化宽屏 ContentDialog 完美居中 -->
            <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
            <x:Double x:Key="ContentDialogMinWidth">780</x:Double>

            <!-- 全局通用转换器 -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
            <converters:WordStateToColorConverter x:Key="WordStateToColorConverter" />
            <converters:WordStateToNameConverter x:Key="WordStateToNameConverter" />
            <converters:CardStateToBorderBrushConverter x:Key="CardStateToBorderBrushConverter" />
            <converters:CardStateToBackgroundBrushConverter x:Key="CardStateToBackgroundBrushConverter" />
            <converters:PercentageConverter x:Key="PercentageConverter" />
            <converters:DateToStringConverter x:Key="DateToStringConverter" />
            <converters:WordCountSuffixConverter x:Key="WordCountSuffixConverter" />
            <converters:RepsCountSuffixConverter x:Key="RepsCountSuffixConverter" />
            <converters:RetentionToTagConverter x:Key="RetentionToTagConverter" />
            <converters:RetentionToColorConverter x:Key="RetentionToColorConverter" />
            <converters:StabilityToHalfLifeConverter x:Key="StabilityToHalfLifeConverter" />
            <converters:DifficultyToRatingConverter x:Key="DifficultyToRatingConverter" />
            <converters:StringFormatConverter x:Key="StringFormatConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
