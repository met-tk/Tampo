<Application x:Class="NihongoVocab.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- 现代优雅浅色 Fluent 样式字典 (Light Clean Aesthetic) -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="WindowBorderBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />
        
        <!-- 核心重点色：高雅现代 Indigo 靛蓝 -->
        <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4338CA" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#3730A3" />
        
        <!-- 危险强调色 (卸载) -->
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626" />

        <!-- 次要操作 -->
        <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#E2E8F0" />

        <!-- 文本层级色 -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#94A3B8" />

        <!-- 输入框相关 -->
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1" />
        <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#4F46E5" />

        <!-- 基础文字字体 -->
        <FontFamily x:Key="FluentFont">Segoe UI, Microsoft YaHei, Meiryo, sans-serif</FontFamily>
    </Application.Resources>
</Application>
