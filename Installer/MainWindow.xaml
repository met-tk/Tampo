<Window x:Class="NihongoVocab.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tampo Setup"
        Height="520" Width="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="{StaticResource FluentFont}"
        Icon="AppIcon.ico">

    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.08" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="AppIcon.ico" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock x:Name="TitleBarText" Text="{Binding SetupTitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="—" Click="MinimizeButton_Click" Width="36" Height="30" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#F1F5F9" />
                                        <Setter Property="Foreground" Value="#0F172A" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="✕" Click="CloseButton_Click" Width="36" Height="30" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#FEE2E2" />
                                        <Setter Property="Foreground" Value="#DC2626" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 主内容区 -->
            <Grid Grid.Row="1" Margin="32,6,32,28">

                <!-- ══ 阶段 1: 安装配置面板 ══ -->
                <Grid x:Name="SetupStepPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- 品牌头 -->
                        <RowDefinition Height="Auto" />
                        <!-- 版本状态横幅（条件显示） -->
                        <RowDefinition Height="Auto" />
                        <!-- 安装路径卡片 -->
                        <RowDefinition Height="*"  />
                        <!-- 偏好设置 -->
                        <RowDefinition Height="Auto" />
                        <!-- 安装按钮 -->
                    </Grid.RowDefinitions>

                    <!-- 品牌头 -->
                    <StackPanel Grid.Row="0" Margin="0,2,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="10" Background="#F8FAFC" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Margin="0,0,16,0">
                                <Image Source="AppIcon.ico" Width="36" Height="36" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Tampo" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SetupSubtitle}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- ── 版本状态横幅（升级 / 重装 / 降级，默认折叠） ── -->
                    <Border x:Name="StatusBannerBorder" Grid.Row="1"
                            BorderThickness="1" CornerRadius="8"
                            Padding="14,12" Margin="0,0,0,14"
                            Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock x:Name="StatusBannerIcon" Text="↑" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusBannerTitle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="StatusBannerVersion" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
                            <TextBlock x:Name="StatusBannerPath" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 安装路径卡片 -->
                    <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding InstallPathLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InstallPathTextBox" Grid.Column="0" Height="36" FontSize="12" VerticalContentAlignment="Center" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource InputBorderBrush}" Padding="10,0">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                                <Button Grid.Column="1" Content="{Binding BrowseButton}" Click="BrowseButton_Click" Width="76" Height="36" Margin="8,0,0,0" Background="{StaticResource SecondaryButtonBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource SecondaryButtonBorderBrush}" BorderThickness="1" Cursor="Hand" FontSize="12">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource SecondaryButtonHoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 偏好设置 -->
                    <StackPanel Grid.Row="3" VerticalAlignment="Top">
                        <CheckBox x:Name="CreateDesktopShortcutCheckBox" IsChecked="True" Content="{Binding DesktopShortcut}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,10" />
                        <CheckBox x:Name="CreateStartMenuShortcutCheckBox" IsChecked="True" Content="{Binding StartMenuShortcut}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                    </StackPanel>

                    <!-- 主操作按钮（文字由代码动态更新） -->
                    <Button x:Name="MainActionButton" Grid.Row="4" Content="{Binding InstallButton}" Click="InstallButton_Click" Height="42" Background="{StaticResource AccentBrush}" Foreground="White" FontSize="14" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ══ 阶段 2: 正在安装进度面板 ══ -->
                <Grid x:Name="ProgressStepPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Width="430">
                        <TextBlock x:Name="ProgressTitleTextBlock" Text="{Binding InstallingTitle}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,20" />
                        <ProgressBar x:Name="InstallProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Background="#F1F5F9" Foreground="{StaticResource AccentBrush}" BorderThickness="0">
                            <ProgressBar.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4" />
                                </Style>
                            </ProgressBar.Resources>
                        </ProgressBar>
                        <TextBlock x:Name="ProgressStatusTextBlock" Text="{Binding StatusExtracting}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                </Grid>

                <!-- ══ 阶段 3: 安装完成面板 ══ -->
                <Grid x:Name="FinishStepPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#ECFDF5" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <TextBlock Text="✓" FontSize="34" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                        </Border>
                        <TextBlock x:Name="SuccessTitleText" Text="{Binding InstallSuccess}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="SuccessDescText" Text="{Binding InstallSuccessDesc}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,24" />
                        <CheckBox x:Name="LaunchAppCheckBox" IsChecked="True" Content="{Binding LaunchApp}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Row="1" Content="{Binding FinishButton}" Click="FinishButton_Click" Height="42" Background="{StaticResource AccentBrush}" Foreground="White" FontSize="14" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
